import sys, os; exec("try:\n import site\n site.ENABLE_USER_SITE = False\n ub = os.path.normcase(site.getuserbase())\n sys.path[:] = [x for x in sys.path if not os.path.normcase(x).startswith(ub)]\n p = sys.argv[0] if sys.argv else ''\n d = os.path.dirname(os.path.abspath(p)) if p and p not in ('-c', '-m') else os.getcwd()\n extra = [x for x in os.environ.get('PYTHONPATH', '').split(os.pathsep) if x]\n sys.path[0:0] = [x for x in [d] + extra if x not in sys.path]\nexcept Exception:\n pass")
